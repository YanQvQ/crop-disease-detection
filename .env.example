# ============================================================
# 农作物病害识别系统 环境变量配置模板
# 使用方法：复制为 .env 文件并按需修改；.env 已被 .gitignore 忽略，切勿提交到仓库
# 优先级：系统环境变量 > .env 文件 > 代码默认值
# ============================================================

# ----- Flask 核心配置 -----
# Flask 运行环境：development（开发调试）或 production（生产）
FLASK_ENV=production

# DEBUG 模式：独立控制 Flask DEBUG 开关，优先级高于 FLASK_ENV
# 允许值：True / False / 1 / 0 / yes / no / on / off
# ⚠️ 生产环境必须为 False，否则会泄漏栈信息与源码！
# DEBUG=False

# Flask 签名密钥（用于 Session / JWT 等），生产环境必须修改为随机长字符串
# 生成方式 1: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生成方式 2: openssl rand -base64 48
# ⚠️ 必填！未修改默认值部署将有安全风险！
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_48bytes

# ----- 数据库配置 -----
# SQLAlchemy 数据库连接串，默认使用 SQLite
# 如需切换 MySQL/PostgreSQL，请按对应格式填写并安装相应驱动
# SQLite 示例: sqlite:///cropdisease.db
# MySQL  示例: mysql+pymysql://user:password@127.0.0.1:3306/cropdisease?charset=utf8mb4
SQLALCHEMY_DATABASE_URI=sqlite:///cropdisease.db

# ----- 安全与认证 -----
# JWT Token 有效期（天），默认 7 天
JWT_EXPIRE_DAYS=7

# ----- 上传与大小限制 -----
# 最大允许上传文件大小（MB），默认 100 MB
MAX_CONTENT_MB=100

# ----- 日志配置 -----
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# 控制台输出与 app.log 文件会同时按该级别过滤
# 开发调试时建议 DEBUG，生产环境建议 INFO 或 WARNING
# LOG_LEVEL=INFO

# ----- CORS / WebSocket 跨域白名单 -----
# 逗号分隔的允许来源。默认仅允许本机开发来源；生产环境请填写实际前端域名
# 前后端同源部署时无需额外配置（同源请求不受 CORS 限制）
# CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
